  "item": [
    {
      "name": "1. Register - success (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = pm.response.json();",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('client_token', data.access);",
              "}",
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Response has access token and api_key', function () {",
              "    pm.expect(data).to.have.property('access');",
              "    pm.expect(data).to.have.property('api_key');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"securepass123\",\n  \"company_name\": \"Acme Corp\",\n  \"email\": \"dev@acmecorp.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
